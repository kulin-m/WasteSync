# Application Settings
PROJECT_NAME="Garbage Truck Monitoring System"
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-config local running, or set PostgreSQL URL
# Examples:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/waste_db"
DATABASE_URL="sqlite+aiosqlite:///./waste_monitoring.db"

# Free OSRM Routing Machine Server URL (100% Free, no API key needed)
OSRM_SERVER_URL="https://router.project-osrm.org"

# Optional: Google Maps API key (if provided, can be used for fallback distance matrix)
GOOGLE_MAPS_API_KEY=""
